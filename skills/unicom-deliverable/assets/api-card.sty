\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{api-card}[2026/10/21 interface card layout sample]

% 版式范本。鉴权行原样印出 YAML 的 auth，不内置角色词表。
% 成功信封、宏前缀 \ea 属于本范本；换项目时复制本文件再改写。
% 生成器不得把 {code,msg,data} 或 {code,msg,total,rows} 焊进碎片。

\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{hhline}
\RequirePackage{expl3}
\RequirePackage{xparse}

\providecommand{\phantomsection}{}

\newlength{\ea@gutterw}
\newlength{\ea@namew}
\newlength{\ea@labelw}
\newlength{\ea@notew}
\newlength{\ea@metaw}
\setlength{\ea@gutterw}{1.65cm}
\setlength{\ea@namew}{3.20cm}
\setlength{\ea@labelw}{2.60cm}

\renewcommand{\arraystretch}{1.18}
\setlength{\tabcolsep}{4pt}

% w-列不是 parbox，空左槽不会在 \end{longtable} 时再挤出一行竖线。
\newcolumntype{G}{w{c}{\ea@gutterw}}
\newcolumntype{P}{>{\raggedright\arraybackslash}p{\ea@namew}}
\newcolumntype{Q}{>{\raggedright\arraybackslash}p{\ea@labelw}}
\newcolumntype{R}{>{\raggedright\arraybackslash}p{\ea@notew}}

\newcounter{ea@depth}

\newcommand{\ea@tt}[1]{{\ttfamily\sloppy #1}}

\newcommand{\ea@span}[1]{%
  \multicolumn{3}{>{\raggedright\arraybackslash}p{\ea@metaw}|}{#1}%
}

% |G|P|Q|R| 对应 hhline：|-|-|-|-|；左槽不断横线用 |~|-|-|-|。
\newcommand{\ea@hline}{\hhline{|-|-|-|-|}}
\newcommand{\ea@clineg}{\hhline{|~|-|-|-|}}

\newcommand{\ea@ident}[2]{%
  #1 & \ea@span{#2} \\
  \ea@hline
}

\newcommand{\ea@cardskip}{\par\vspace{1.2em}}

% ----- 字段行（列：左槽已由 block 占用 | 名 | 中文名 | 说明）-----
% \cline 必须是该行的第一个对齐原语，所以首行用 EaFieldFirst。
\newcommand{\EaFieldFirst}[3]{%
  &\hspace*{\value{ea@depth}em}\ea@tt{#1}&#2&#3\\%
}
\newcommand{\EaField}[3]{%
  \ea@clineg
  &\hspace*{\value{ea@depth}em}\ea@tt{#1}&#2&#3\\%
}
\newcommand{\EaKids}[1]{%
  \noalign{\addtocounter{ea@depth}{1}}%
  #1%
  \noalign{\addtocounter{ea@depth}{-1}}%
}

% 左槽顶对齐，不用 multirow：避免表底多出竖线，跨页也不把左槽撑破。
\newcommand{\ea@block}[3]{%
  \ifnum#2>0
    \setcounter{ea@depth}{0}%
    #1%
    #3%
    \ea@hline
  \fi
}

\newcommand{\ea@envrow}[3]{%
  \EaField{#1}{#2}{#3}%
}
\newcommand{\ea@envrowfirst}[3]{%
  \EaFieldFirst{#1}{#2}{#3}%
}

% begin/end longtable 必须在 2e 下执行；expl3 里 \end{longtable} 会多出左槽空行竖线。
\newcommand{\ea@opentable}{%
  \setlength{\ea@notew}{\dimexpr\textwidth-\ea@gutterw-\ea@namew-\ea@labelw-8\tabcolsep-5\arrayrulewidth\relax}%
  \setlength{\ea@metaw}{\dimexpr\textwidth-\ea@gutterw-4\tabcolsep-3\arrayrulewidth\relax}%
  \ea@cardskip
  \phantomsection
  \noindent
  \footnotesize
  \begin{longtable}{|G|P|Q|R|}%
  \ea@hline
}
\newcommand{\ea@closetable}{%
  \end{longtable}%
  \normalsize
  \par
}

% ----- 键值 -----
