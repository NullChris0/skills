\tl_new:N \l_ea_method_tl
\tl_new:N \l_ea_path_tl
\tl_new:N \l_ea_nesma_tl
\tl_new:N \l_ea_table_tl
\tl_new:N \l_ea_auth_tl
\tl_new:N \l_ea_sameorigin_tl
\tl_new:N \l_ea_envelope_tl
\tl_new:N \l_ea_responsejava_tl
\tl_new:N \l_ea_filekind_tl
\tl_new:N \l_ea_filename_tl
\tl_new:N \l_ea_tablename_tl
\tl_new:N \l_ea_pathparams_tl
\tl_new:N \l_ea_query_tl
\tl_new:N \l_ea_body_tl
\tl_new:N \l_ea_form_tl
\tl_new:N \l_ea_data_tl
\tl_new:N \l_ea_rule_tl
\tl_new:N \l_ea_example_tl
\tl_new:N \l_ea_id_tl
\int_new:N \l_ea_pathrows_int
\int_new:N \l_ea_queryrows_int
\int_new:N \l_ea_bodyrows_int
\int_new:N \l_ea_formrows_int
